{
  "name": "monash-wam-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-page-seo-json.mjs && vite build && node scripts/inject-route-meta.mjs && node scripts/prerender.mjs",
    "build:seo-data": "node scripts/build-page-seo-json.mjs",
    "build:no-prerender": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "compress-article-image": "node scripts/compress-featured-image.mjs",
    "compress-home-images": "node scripts/compress-home-images.mjs",
    "test:calculators": "node scripts/test-calculators.mjs",
    "generate-favicons": "node scripts/generate-favicons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@sparticuz/chromium": "^149.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.35",
    "puppeteer": "^25.3.0",
    "puppeteer-core": "^25.3.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
